{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradingRubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["checks"],
  "properties": {
    "recalc": {
      "type": "boolean",
      "default": true,
      "description": "If true, recalc the candidate xlsx with soffice before grading."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "weight"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "type": "string",
            "enum": [
              "numeric",
              "sheet_exists",
              "label_exists",
              "formula_driven",
              "output_key",
              "output_key_formula",
              "numeric_by_label",
              "formula_by_label",
              "numeric_anywhere",
              "bs_balances",
              "hardcode_penalty",
              "value_range",
              "range_sum",
              "llm_judge"
            ]
          },
          "weight": {"type": "number"},
          "sheet": {"type": "string"},
          "cell": {"type": "string"},
          "range": {"type": "string"},
          "expected": {},
          "tolerance_abs": {"type": "number"},
          "tolerance_rel": {"type": "number"},
          "text": {"type": "string"},
          "key": {"type": "string"},
          "require_formula": {"type": "boolean"},
          "label": {"type": "string"},
          "labels": {"type": "array", "items": {"type": "string"}},
          "col_offset": {"type": "integer"},
          "row_offset": {"type": "integer"},
          "scope": {"type": "string", "enum": ["workbook", "sheet"]},
          "years": {"type": "array", "items": {"type": "string"}},
          "assets_row": {"type": "integer"},
          "liab_equity_row": {"type": "integer"},
          "columns": {"type": "array", "items": {"type": "string"}},
          "source_cell": {"type": "string"},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "criterion": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  }
}
